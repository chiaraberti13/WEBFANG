# Hardening supply-chain (vedi SECURITY.md e roadmap §Threat model).
#
# Gli script di lifecycle delle dipendenze (preinstall/install/postinstall)
# sono disabilitati per default, così un pacchetto transitivo malevolo non può
# eseguire codice durante `pnpm install`. pnpm consente i build script nativi
# solo tramite l'allowlist esplicita in package.json → `pnpm.onlyBuiltDependencies`.
# Aggiungere una voce richiede una motivazione in PR e review di sicurezza.
ignore-scripts=true

# Rifiuta di girare con un package manager diverso da quello pinnato.
engine-strict=true

# Disciplina delle dipendenze esplicite ("secure by default"): mai materializzare
# in automatico peer dependency non dichiarate, che allargherebbero la superficie
# d'installazione senza una modifica revisionata del manifest.
auto-install-peers=false
