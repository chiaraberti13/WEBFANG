{
  "name": "webfang",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WebFang — Offensive Web Toolkit. Contesto → trasformazione → difesa, 100% client-side.",
  "license": "GPL-3.0-only",
  "author": "Chiara Berti",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0 || >=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:singlefile": "tsc -b && cross-env BUILD_TARGET=singlefile vite build --outDir dist-singlefile",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dompurify": "3.2.6",
    "lz-string": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "cross-env": "7.0.3",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vite-plugin-pwa": "0.21.1",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
